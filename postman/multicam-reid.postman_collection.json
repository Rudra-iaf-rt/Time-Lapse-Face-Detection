{
  "info": {
    "name": "MultiCam Re-ID API",
    "description": "Health, auth, persons, search, cameras, tracks, analytics, admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "{{baseUrl}}" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health" }
        },
        {
          "name": "GET /live",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('alive', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/live" }
        },
        {
          "name": "GET /ready",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('structured ready', () => { const j = pm.response.json(); pm.expect(j).to.have.property('dependencies'); });"] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/ready" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('login ok', () => pm.response.to.have.status(200));",
                "const j = pm.response.json();",
                "if (j.access_token) { pm.collectionVariables.set('token', j.access_token); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{username}}" },
                { "key": "password", "value": "{{password}}" }
              ]
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Persons",
      "item": [
        {
          "name": "List persons",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/persons"
          }
        },
        {
          "name": "Person detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/persons/{{global_id}}"
          }
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Search persons",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/search/persons?limit=10"
          }
        }
      ]
    },
    {
      "name": "Cameras",
      "item": [
        {
          "name": "List cameras",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/cameras"
          }
        },
        {
          "name": "Topology",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/cameras/topology/graph"
          }
        }
      ]
    },
    {
      "name": "Tracks",
      "item": [
        {
          "name": "List tracks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/tracks"
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/analytics/summary"
          }
        },
        {
          "name": "Anomalies",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/analytics/anomalies"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Identity stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/admin/identity-stats"
          }
        }
      ]
    }
  ]
}
