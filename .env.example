# Copy to .env and fill in values. Never commit real secrets.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=multicam_reid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT / Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
# Defaults match api/dependencies/auth.py when env vars are unset
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-change-me
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator-change-me
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer-change-me

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=*

# Legacy SQLite (Streamlit)
REID_DB_PATH=database/identities.db
CONFIG_PATH=config.yaml

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/ws
